   "source": [
    "values = [\n",
    "    \"cat is here\",\n",
    "    \"dog is here\",\n",
    "    \"a dog is here\"\n",
    "]\n",
    "\n",
    "pattern = r\"^(cat|dog)\"\n",
    "\n",
    "for value in values:\n",
    "    r = re.match(pattern, value)\n",
    "    if r:\n",
    "        print(r)\n",
    "        print(r.groups())"
   ]
